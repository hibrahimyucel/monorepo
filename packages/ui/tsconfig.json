{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "declaration": true,      // CRITICAL: Generates explicit .d.ts maps for Vite
    "declarationMap": true   // Helps resolution mapping across workspaces
  },
  "include": ["src/**/*", "index.ts"] // Explicitly include the root index file
}

